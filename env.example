# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testapi

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@example.com

# SMTP (optional — for contact form emails)
SMTP_HOST=
SMTP_PORT=
